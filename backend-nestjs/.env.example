# Optional local configuration. Copy to .env only if you do not already have one.
# The backend reads .env without overwriting existing process environment values.
NODE_ENV=development
PORT=3000

# Set conversational to use the configured model for grounded chat and voice.
# no-llm preserves deterministic operation without a model service.
AGENT_RESPONSE_MODE=no-llm
# Native Ollama uses these existing settings. Never put credentials in this URL.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_ENABLED=false
# Integer milliseconds, 1000-300000. Covers connection AND response-body reading.
OLLAMA_TIMEOUT_MS=120000

# May be reduced, not raised above the existing safety ceilings.
# The last round is reserved for a final answer without tools.
AGENT_MAX_ROUNDS=4
# All tool attempts count, including backend-controlled knowledge_search.
AGENT_MAX_TOOL_CALLS=5

# The development tenant header is NOT an authentication credential.
# Production tenant requests require a verified access JWT and live DB membership.

# ---------------------------------------------------------------------------
# MySQL 8 database (accepted Phase 6B foundation).
# Required in production (the app fails closed without it). In development the
# app boots WITHOUT a database when these are absent (graceful mode).
# XAMPP MariaDB 10.4 is NOT interchangeable: the accepted migrations require
# utf8mb4_0900_ai_ci. Use installed local MySQL 8; do not rewrite migrations.
# Never commit a real .env; credentials come only from the environment.
# ---------------------------------------------------------------------------
# MySQL host; use 127.0.0.1 for the installed local MySQL 8 server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=mczen_app
DB_PASSWORD=change-me
DB_DATABASE=mczen_db
DB_SYNCHRONIZE=false
# Migration commands (migration:run/revert/show/check) use a DIFFERENT, DDL-capable
# account and never fall back to the runtime user above. Not read at app startup.
# DB_MIGRATION_USERNAME=mczen_migrator
# DB_MIGRATION_PASSWORD=change-me
# Legacy aliases DB_USER and DB_NAME remain accepted for existing deployments.
# Optional tuning (integers; defaults 10000 ms connect timeout, 10 pool conns).
# DB_CONNECT_TIMEOUT_MS=10000
# DB_CONNECTION_LIMIT=10

# Authentication (Phase 6C). Actual contracts/runbook: docs/AUTH-API.md.
# Access TTL: integer 600-900 seconds. Refresh/session TTL: 1-2592000 seconds.
# Refresh rotation never extends the original session/family expiry horizon.
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# JWT signing key (HS256). REQUIRED in production (>= 32 random bytes; the app
# fails closed without it). In development a per-process ephemeral secret is
# generated when missing (tokens do not survive restarts).
# JWT_SECRET=<generate-in-your-secrets-manager; do-not-use-a-placeholder>
# Optional key rotation: keep the previous key and both kIDs while migrated
# clients drain. Signatures verify against either key; new tokens sign with the
# current one. Leave JWT_PREVIOUS_SECRET empty when not rotating.
# JWT_PREVIOUS_SECRET=
# JWT_CURRENT_KID=v1
# JWT_PREVIOUS_KID=v0

# Exact dashboard origins, comma-separated, at most 32. No wildcards, paths,
# trailing slash or credentials. Development defaults to the two local origins;
# production defaults to no browser origins and permits HTTPS origins only.
# CORS never enables credential cookies. Missing Origin is allowed for API callers.
# MCZEN_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Production example: MCZEN_CORS_ORIGINS=https://dashboard.example.test

# Deliberately hardened development allowlist: in non-production ONLY, with a
# direct loopback socket peer, and only when this value is exactly 1, the legacy
# header (`x-mczen-tenant-id`) is honored on /api/agent/ask and /api/agent/tools.
# These are DATABASE-FREE Phase 5 demo identities, not seeded production tenants.
# Forwarding headers are rejected; an invalid bearer never falls back to a demo.
# Production NEVER consults it. Keep it disabled on publicly reachable servers.
MCZEN_ALLOW_DEV_HEADER=0

# Verification/reset tokens never appear in logs or normal auth responses.
# Optional LOCAL-only test convenience: expose them in response bodies when 1,
# non-production, direct loopback, and no forwarding headers. Never production.
MCZEN_EXPOSE_DEV_AUTH_TOKENS=0

# Vendor-neutral SMTP. Unset host = unavailable; production register and
# forgot-password return a uniform 503 before identity lookup. Real email
# delivery requires operator configuration and verification; no provider is bundled.
# Implicit verified TLS is the default (465); port 587 uses required STARTTLS.
# MCZEN_SMTP_HOST=smtp.example.test
# MCZEN_SMTP_PORT=465
# MCZEN_SMTP_SECURE=1
# MCZEN_SMTP_FROM=McZEN <noreply@example.test>
# Set both credentials, or neither for a TLS-protected authenticated relay.
# MCZEN_SMTP_USER=<operator-supplied>
# MCZEN_SMTP_PASSWORD=<operator-supplied-secret>

# Process-local sliding 60-second windows. Integers may be reduced, not raised
# above these defaults/ceilings. Full key capacity fails closed with 429.
# The IP check precedes JSON parsing and includes unknown paths and preflights.
# MCZEN_RATE_IP_PER_MINUTE=300
# MCZEN_RATE_SESSION_PER_MINUTE=120
# MCZEN_RATE_TENANT_PER_MINUTE=600
# MCZEN_RATE_MAX_KEYS=10000
# Fixed tighter auth limits per IP/minute: register 5, login 10, refresh 30,
# forgot-password 5, reset-password 5, verify-email 10. Login/forgot additionally
# limit normalized mailbox hashes; refresh additionally limits credential hashes.
# Forwarded addresses are never trusted. A proxy shares one peer-IP quota;
# multi-instance production requires shared edge quotas and request/concurrency caps.

# Future phases add SECRET_MASTER_KEY (tool-secret encryption), widget/voice
# credentials and durable audit/retention. They are not implemented in 6C.
